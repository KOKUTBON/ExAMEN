# Copy to .env and adjust. Docker Compose reads .env automatically; for ./gradlew bootRun export
# the variables in your shell. Never commit a real .env file.

# --- Database -------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=examen
# Used only when running the backend outside Docker (Compose points it at the postgres service).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/examen
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# --- Security -------------------------------------------------------------------------------
# Required. Random value of at least 32 bytes, e.g. `openssl rand -base64 48`.
APP_JWT_SECRET=
# Browser origins allowed to call the API (comma-separated).
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4001

# --- Frontend -------------------------------------------------------------------------------
# Public origin of the web app (canonical URLs, sitemap, links in emails).
APP_PUBLIC_URL=http://localhost:4001
# Optional. API base URL used by the browser; defaults to <host>:8080/api on localhost
# and to same-origin /api elsewhere (see deploy/nginx.conf).
PUBLIC_API_URL=

# --- Password reset -------------------------------------------------------------------------
APP_PASSWORD_RESET_URL=http://localhost:4001/auth/reset
APP_PASSWORD_RESET_FROM=no-reply@localhost
APP_PASSWORD_RESET_MAX_REQUESTS=3
APP_PASSWORD_RESET_WINDOW_MINUTES=60
APP_PASSWORD_RESET_TOKEN_TTL_MINUTES=60
APP_PASSWORD_RESET_MAIL_ENABLED=true

# --- SMTP (optional; without it reset links are written to the backend log) ------------------
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true

# --- Daily reminders ------------------------------------------------------------------------
APP_REMINDER_ENABLED=true
APP_REMINDER_MAIL_ENABLED=true
APP_REMINDER_FROM=no-reply@localhost
APP_REMINDER_SUBJECT=Your daily Examen reminder
APP_REMINDER_APP_URL=http://localhost:4001/examination
APP_REMINDER_CRON=0 * * * * *

# --- Optional Gemini insights ---------------------------------------------------------------
# When disabled or without a key, insights come from local heuristics and no reflection text
# leaves the server. Enabling sends selected reflection text to Google; tell your users.
APP_GEMINI_ENABLED=false
APP_GEMINI_API_KEY=
APP_GEMINI_MODEL=gemini-2.5-flash
