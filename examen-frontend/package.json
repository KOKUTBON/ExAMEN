{
  "name": "examen-frontend",
  "version": "0.0.1",
  "description": "Privacy-first, self-hosted web application for daily mindfulness reflection and moral inventory",
  "author": "Rei Doda",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "seo:sitemap": "node scripts/generate-sitemap.mjs",
    "prebuild": "npm run seo:sitemap",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:install": "playwright install chromium",
    "serve:ssr:examen-frontend": "node dist/examen-frontend/server/server.mjs",
    "build:demo": "ng build --configuration demo && node scripts/prepare-demo.mjs",
    "build:demo:cf": "ng build --configuration demo --base-href /",
    "preview:demo": "node scripts/serve-demo.mjs",
    "e2e:demo": "playwright test --config playwright.demo.config.ts"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.2.24",
    "@angular/compiler": "^21.2.24",
    "@angular/core": "^21.2.24",
    "@angular/forms": "^21.2.24",
    "@angular/platform-browser": "^21.2.24",
    "@angular/platform-server": "^21.2.24",
    "@angular/router": "^21.2.24",
    "@angular/ssr": "^21.2.24",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.24",
    "@playwright/test": "^1.53.2",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
